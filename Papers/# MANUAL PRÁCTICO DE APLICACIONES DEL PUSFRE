## APÉNDICE C: IMPLEMENTACIÓN RÁPIDA EN PYTHON

```python
# PUSFRE Quickstart - Resuelve cualquier problema en 10 líneas
import numpy as np

def solve_problem(S, phi, psi, N0, R, alpha=1.2, gamma=0.4, sigma=0.15, steps=100):
    """
    S: número de partes
    phi: array de geometría (S,)
    psi: array de deuda (S,)
    N0: frecuencias iniciales (S,)
    R: recurso total
    alpha, gamma, sigma: parámetros
    steps: pasos de simulación
    """
    N = N0 / N0.sum()
    for t in range(steps):
        epsilon = np.random.lognormal(0, sigma, S)
        F = phi * psi * (N ** alpha) * epsilon
        N = R * F / F.sum()
    return N  # asignación final

# Ejemplo: gestión de flotas pesqueras
S = 5
phi = np.array([0.95, 0.85, 0.60, 0.45, 0.70])
psi = np.array([0.68, 0.76, 0.92, 0.96, 0.84])
N0 = np.array([0.267, 0.238, 0.160, 0.131, 0.199])
R = 10000  # toneladas
result = solve_problem(S, phi, psi, N0, R)
print("Capturas sostenibles (toneladas):", result)
