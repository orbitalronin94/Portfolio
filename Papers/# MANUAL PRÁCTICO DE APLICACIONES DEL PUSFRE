class TrafficController:
    def __init__(self, intersections):
        self.intersections = intersections
        self.engine = UnifiedDynamicsEngine(len(intersections))
    
    def step(self):
        for i, inter in enumerate(self.intersections):
            inter['phi'] = inter['flow'] / max_flow
            inter['psi'] = 1 - 0.3 * inter['congestion']
        freqs = np.array([inter['green_time'] for inter in self.intersections])
        freqs = freqs / freqs.sum()
        result = self.engine.step(freqs, phi, psi, debt)
        for i, inter in enumerate(self.intersections):
            inter['green_time'] = result['frequencies'][i] * 120
```

